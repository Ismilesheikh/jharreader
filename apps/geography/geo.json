[],[],[],[],[],[],[],[],[],[],[{"type":"text","data":"* विश्व में सर्वाधिक लवणता वान झील (Lake Van टर्की (तुर्की) में पाई जाती है। \n* वान झील की लवणता लगभग 330% (प्रति हजार) या 33% है।"}],[],[
  {"type":"text","data":"प्रवाल (Corals) समुद्री जीव होते हैं, जो छोटे-छोटे पॉलिप्स के समूह से बनते हैं और कैल्शियम कार्बोनेट का कठोर ढांचा बनाते हैं।"},
  {"type":"text","data":"प्रवाल भित्ति समुद्री जीवों द्वारा निर्मित विशाल चूना पत्थर की संरचना होती है, जो हजारों वर्षों में विकसित होती है।"},
  {"type":"text","data":"प्रवाल के विकास के लिए उथला, स्वच्छ, गर्म और अवसाद रहित जल आवश्यक होता है, क्योंकि गंदला जल प्रकाश को अवरुद्ध करता है।"},
  {"type":"text","data":"प्रवाल मुख्यतः उष्ण कटिबंधीय महासागरों में उत्पन्न होते हैं, जहाँ पर्याप्त तापमान और सूर्य का प्रकाश उपलब्ध रहता है।"},
  {"type":"text","data":"प्रवाल जीवों के विकास के लिए 70°F से 80°F तापमान उपयुक्त होता है, जिससे उनके जीवन क्रियाएँ सही रहती हैं।"},
  {"type":"text","data":"प्रवालों के लिए 32‰ से 37‰ के बीच सागरीय लवणता उपयुक्त मानी जाती है, क्योंकि इससे उनका विकास संतुलित रहता है।"},
  {"type":"text","data":"प्रवाल भित्तियाँ सामान्यतः 30° उत्तर से 30° दक्षिण अक्षांशों के बीच पाई जाती हैं, जहाँ समुद्र का जल गर्म होता है।"},
  {"type":"text","data":"तट से दूर स्थित प्रवाल भित्ति को अवरोधक प्रवाल भित्ति कहते हैं, जो तट और भित्ति के बीच लैगून बनाती है।"},
  {"type":"text","data":"एटॉल प्रवाल भित्ति का वृत्ताकार या घोड़े की नाल जैसा आकार होता है, जिसके बीच में लैगून पाया जाता है।"},
  {"type":"text","data":"तटीय भित्ति और स्थल खंड के बीच बने जल क्षेत्र को लैगून कहा जाता है, जो शांत और उथला जल क्षेत्र होता है।"},
  {"type":"text","data":"भू-अवतलन सिद्धांत चार्ल्स डार्विन द्वारा दिया गया, जिसमें समुद्री तल के धीरे-धीरे धंसने की प्रक्रिया बताई गई है।"},
  {"type":"text","data":"हिमानी नियंत्रण सिद्धांत डेली द्वारा दिया गया, जिसमें हिम युग के कारण समुद्र स्तर परिवर्तन को कारण माना गया है।"},
  {"type":"text","data":"ग्रेट बैरियर रीफ विश्व की सबसे बड़ी प्रवाल भित्ति है, जो ऑस्ट्रेलिया के पूर्वी तट के पास स्थित है।"},
  {"type":"text","data":"इसकी लंबाई लगभग 1900 किमी और चौड़ाई लगभग 160 किमी है, जिससे यह विश्व की सबसे बड़ी जीवित संरचना है।"},
  {"type":"text","data":"ग्रेट बैरियर रीफ अवरोधक प्रवाल भित्ति का उदाहरण है, जो तट से दूर स्थित होती है।"},
  {"type":"text","data":"प्रवाल भित्तियाँ समुद्र के उष्णकटिबंधीय वर्षा वनों जैसी होती हैं, क्योंकि इनमें अत्यधिक जैव विविधता होती है।"},
  {"type":"text","data":"विश्व की सबसे बड़ी प्रवाल भित्ति ऑस्ट्रेलिया के तट के पास स्थित है, जिसे ग्रेट बैरियर रीफ कहते हैं।"},
  {"type":"text","data":"'ग्रेट बैरियर रीफ' ऑस्ट्रेलिया महाद्वीप के समीप स्थित है और यह जैव विविधता का प्रमुख केंद्र है।"},
  {"type":"text","data":"कोरल रीफ सामान्यतः कर्क और मकर रेखा के बीच के गर्म तटीय क्षेत्रों में पाई जाती हैं।"},
  {"type":"text","data":"पोर्टब्लेयर के पास की प्रवाल भित्तियाँ मुख्यतः भूमंडलीय ऊष्मन के कारण नष्ट हो रही हैं।"}
],[
  {"type":"text","data":"पृथ्वी के कुल क्षेत्रफल का लगभग 71% भाग जल से आच्छादित है, जिससे इसे ‘नीला ग्रह’ कहा जाता है।"},
  {"type":"text","data":"उत्तरी गोलार्द्ध में जलमंडल का विस्तार लगभग 60.7% है, क्योंकि यहाँ स्थल भाग अधिक पाया जाता है।"},
  {"type":"text","data":"दक्षिणी गोलार्द्ध में जलमंडल का विस्तार लगभग 80.9% है, इसलिए इसे जल गोलार्द्ध भी कहा जाता है।"},
  {"type":"text","data":"महाद्वीप से महासागर की ओर क्रम होता है: महाद्वीपीय मग्न तट → महाद्वीपीय मग्न ढाल → गहरे सागरीय मैदान → महासागरीय गर्त।"},
  {"type":"text","data":"सागर की ओर तीव्र ढाल वाला भाग महाद्वीपीय मग्न ढाल कहलाता है, जहाँ गहराई तेजी से बढ़ती है।"},
  {"type":"text","data":"महाद्वीपीय मग्न तट और गहरे सागरीय मैदान के बीच महाद्वीपीय मग्न ढाल स्थित होती है।"},
  {"type":"text","data":"घटते क्षेत्रफल का क्रम है: गहन सागरीय मैदान → महाद्वीपीय मग्न तट → महाद्वीपीय मग्न ढाल → महासागरीय गर्त।"},
  {"type":"text","data":"महाद्वीपीय मग्न तट महासागरीय क्षेत्रफल के लगभग 7.5% भाग पर फैला होता है।"},
  {"type":"text","data":"असत्य कथन यह है कि इसका सर्वाधिक विस्तार प्रशान्त महासागर में है; वास्तव में अटलांटिक में अधिक है।"},
  {"type":"text","data":"महाद्वीपीय मग्न तट का सर्वाधिक विस्तार अटलांटिक महासागर में पाया जाता है।"},
  {"type":"text","data":"अधिकांश मछलियाँ और समुद्री जीव महाद्वीपीय मग्न तट से प्राप्त होते हैं क्योंकि यह पोषक तत्वों से समृद्ध होता है।"},
  {"type":"text","data":"विश्व का सबसे चौड़ा महाद्वीपीय मग्न तट आर्कटिक महासागर में स्थित है।"},
  {"type":"text","data":"महाद्वीप से जुड़ा उथला डूबा भाग, जिसकी गहराई 600 फीट तक होती है, महाद्वीपीय मग्न तट कहलाता है।"},
  {"type":"text","data":"जहाँ तट के पास पर्वत होते हैं, वहाँ महाद्वीपीय मग्न तट संकरा या कटा-घटा होता है।"},
  {"type":"text","data":"विश्व के लगभग 25% खनिज तेल और प्राकृतिक गैस का उत्पादन महाद्वीपीय मग्न तट से होता है।"},
  {"type":"text","data":"असत्य कथन नहीं है; सभी कथन सही हैं क्योंकि यह ढाल तट और गहरे मैदान के बीच होती है।"},
  {"type":"text","data":"महाद्वीपीय मग्न ढाल महासागरीय क्षेत्रफल के लगभग 6.5% भाग पर फैली होती है।"},
  {"type":"text","data":"गम्भीर सागरीय मैदान महासागरीय क्षेत्रफल के लगभग 76% भाग पर विस्तृत होते हैं।"},
  {"type":"text","data":"गम्भीर सागरीय मैदान का सर्वाधिक विस्तार प्रशान्त महासागर में पाया जाता है।"},
  {"type":"text","data":"सभी कथन सही हैं: यह विशाल क्षेत्र घेरता है, 3000-6000 मीटर गहरा होता है और व्यापक अक्षांशों में पाया जाता है।"},
  {"type":"text","data":"महासागरीय गर्तों की सर्वाधिक संख्या प्रशान्त महासागर में पाई जाती है।"},
  {"type":"text","data":"विश्व में लगभग 57 महासागरीय गर्तों का पता लगाया जा चुका है।"},
  {"type":"text","data":"महासागरीय गर्तों की सामान्य गहराई लगभग 7000 मीटर होती है।"},
  {"type":"text","data":"विश्व का सबसे गहरा महासागरीय गर्त मेरियाना गर्त है।"},
  {"type":"text","data":"मेरियाना गर्त की गहराई लगभग 11,033 मीटर है, जो पृथ्वी का सबसे गहरा बिंदु है।"},
  {"type":"text","data":"प्यूर्टोरिको गर्त प्रशान्त महासागर में नहीं बल्कि अटलांटिक महासागर में स्थित है।"},
  {"type":"text","data":"चैलेन्जर गर्त मेरियाना गर्त में गुआम द्वीपमाला के निकट स्थित है।"},
  {"type":"text","data":"सपाट शीर्ष वाले समुद्री पर्वतों को गुयॉट (Guyot) कहा जाता है।"},
  {"type":"text","data":"मध्य अटलांटिक कटक की लंबाई लगभग 14,000 किमी है।"},
  {"type":"text","data":"समुद्री पहाड़ियों की न्यूनतम ऊँचाई लगभग 1000 मीटर मानी जाती है।"},
  {"type":"text","data":"सबसे अधिक नितल पहाड़ियाँ प्रशान्त महासागर में पाई जाती हैं।"},
  {"type":"text","data":"प्रशान्त महासागर में लगभग 10,000 नितल पहाड़ियाँ पाई जाती हैं।"},
  {"type":"text","data":"विश्व में लगभग 102 जलमग्न केनियन पाए जाते हैं।"},
  {"type":"text","data":"जलमग्न केनियन सबसे अधिक अटलांटिक महासागर में पाए जाते हैं।"},
  {"type":"text","data":"सबसे लंबे जलमग्न केनियन बेरिंग सागर में पाए जाते हैं।"},
  {"type":"text","data":"डॉल्फिन चैलेन्जर कटक अटलांटिक महासागर में स्थित है।"},
  {"type":"text","data":"सुण्डा गर्त सुमात्रा के दक्षिण में स्थित है और यह एक प्रमुख महासागरीय गर्त है।"}
